# ===================================
# QuiniGana Backend - Environment Variables
# ===================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# -----------------------------------
# Server Configuration
# -----------------------------------
PORT=3000
NODE_ENV=development
# Options: development, production, test

# -----------------------------------
# Database (MySQL)
# -----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=quinigana_db

# -----------------------------------
# JWT Authentication (REQUIRED)
# -----------------------------------
# IMPORTANT: These MUST be set. Server will NOT start without them.
# Use strong, unique secrets of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------
# Google OAuth 2.0
# -----------------------------------
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# -----------------------------------
# Frontend URL (CORS & Redirects)
# -----------------------------------
FRONTEND_URL=http://localhost:4200

# -----------------------------------
# Email (Nodemailer / SMTP)
# -----------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=QuiniGana <noreply@quinigana.com>

# -----------------------------------
# Rate Limiting
# -----------------------------------
RATE_LIMIT_WINDOW_MS=900000
# General rate limit max requests per window
RATE_LIMIT_MAX=100
# Auth rate limit: 10 requests per 15 min (hardcoded)
# Lockout: 30 min after 5 failed login attempts (hardcoded)

# -----------------------------------
# CSRF Protection
# -----------------------------------
# Set to 'true' ONLY in development to disable CSRF validation
# NEVER disable in production
# CSRF_DISABLED=true

# -----------------------------------
# Logging
# -----------------------------------
LOG_LEVEL=info
# Options: fatal, error, warn, info, debug, trace

# -----------------------------------
# Football Data API
# -----------------------------------
# Get your API key at: https://www.football-data.org/
FOOTBALL_DATA_API_KEY=your-football-data-api-key

# -----------------------------------
# Web Push (VAPID Keys)
# -----------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@quinigana.com

# -----------------------------------
# WebSocket / Scraper
# -----------------------------------
SOCKET_SCRAPE_INTERVAL=30000
SCRAPER_PROXY_URL=
SCRAPER_MIN_DELAY_MS=300
SCRAPER_MAX_DELAY_MS=800
SCRAPER_CACHE_TTL_MS=25000
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_RETRIES=2
